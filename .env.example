# =============================================================================
# DPOS Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Neo4j Database Configuration
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_DATABASE=neo4j

# For Neo4j Aura (cloud):
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io

# -----------------------------------------------------------------------------
# Kafka Configuration (Optional - for streaming)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# LLM Configuration (Ollama - Default)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# For OpenAI (alternative LLM provider):
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4

# For Anthropic (alternative LLM provider):
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# LLM Provider selection: ollama, openai, anthropic
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# API Security Configuration
# -----------------------------------------------------------------------------
# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_openssl
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key for service-to-service auth (optional)
API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (never in production!)
DEBUG=false

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# CORS Configuration (comma-separated origins)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# Observability / Tracing
# -----------------------------------------------------------------------------
# LangSmith tracing (optional - for agent debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=dpos-agents

# OpenTelemetry endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics port (optional)
# METRICS_PORT=9090

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
MCP_SERVER_NAME=dpos-mcp
MCP_SERVER_PORT=8001

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Default agent timeout (seconds)
AGENT_TIMEOUT_SECONDS=120

# Enable human-in-the-loop for critical actions
HITL_ENABLED=true

# SLA monitoring interval (seconds)
SLA_MONITOR_INTERVAL=300

# Insights report generation (cron expression)
INSIGHTS_CRON=0 8 * * *

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_STREAMING_ENABLED=true
FEATURE_PREDICTIVE_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
