      "created_by": "data-steward@company.com",
      "approved_by": "governance@company.com",
      "rules": [
        {
          "id": "rule_dp005_01",
          "name": "inventory_id_unique",
          "description": "Inventory ID must be unique",
          "type": "uniqueness",
          "field": "inventory_id",
          "severity": "error",
          "enabled": true
        },
        {
          "id": "rule_dp005_02",
          "name": "product_ref_valid",
          "description": "Product ID must exist in product catalog",
          "type": "referential",
          "field": "product_id",
          "reference_product": "DP006",
          "reference_field": "product_id",
          "severity": "error",
          "enabled": true
        },
        {
          "id": "rule_dp005_03",
          "name": "quantity_non_negative",
          "description": "Quantity must be non-negative",
          "type": "range",
          "field": "quantity",
          "min_value": 0,
          "severity": "error",
          "enabled": true
        },
        {
          "id": "rule_dp005_04",
          "name": "freshness_check",
          "description": "Data should be no older than 5 minutes",
          "type": "freshness",
          "max_age_seconds": 300,
          "severity": "error",
          "enabled": true
        },
        {
          "id": "rule_dp005_05",
          "name": "reserved_less_than_total",
          "description": "Reserved quantity should not exceed total quantity",
          "type": "custom",
          "custom_expression": "reserved_quantity <= quantity",
          "severity": "error",
          "enabled": true
        }
      ]
    },
