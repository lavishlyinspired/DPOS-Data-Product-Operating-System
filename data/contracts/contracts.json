    {
      "id": "contract_dp005",
      "product_id": "DP005",
      "name": "Inventory Levels Contract",
      "description": "Data quality contract for inventory data ensuring stock accuracy",
      "version": "1.0.0",
      "enforcement_mode": "strict",
      "effective_from": "2024-03-15T00:00:00Z",
      "effective_until": null,
      "is_active": true,
      "created_at": "2024-03-15T00:00:00Z",
